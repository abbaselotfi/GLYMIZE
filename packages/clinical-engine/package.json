{
  "name": "@glymize/clinical-engine",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index-runtime.js",
  "types": "./dist/index-runtime.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index-runtime.d.ts",
      "default": "./dist/index-runtime.js"
    },
    "./scenario-engine": {
      "types": "./dist/scenario-engine-safe.d.ts",
      "default": "./dist/scenario-engine-safe.js"
    },
    "./insulin-conversion": {
      "types": "./dist/insulin-conversion.d.ts",
      "default": "./dist/insulin-conversion.js"
    },
    "./lab-text-parser": {
      "types": "./dist/lab-text-parser.d.ts",
      "default": "./dist/lab-text-parser.js"
    },
    "./patient-document-parser": {
      "types": "./dist/patient-document-parser.d.ts",
      "default": "./dist/patient-document-parser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint --diagnostic-level=error .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/evidence-casebase-uci-v1.test.ts",
    "test:evidence": "vitest run test/evidence-casebase-uci-v1.test.ts"
  },
  "dependencies": {
    "@glymize/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
