{
  "name": "@glymize/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patient-core": {
      "types": "./dist/patient-core/index.d.ts",
      "default": "./dist/patient-core/index.js"
    },
    "./clinical-modules": {
      "types": "./dist/clinical-modules.d.ts",
      "default": "./dist/clinical-modules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint --diagnostic-level=error .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
