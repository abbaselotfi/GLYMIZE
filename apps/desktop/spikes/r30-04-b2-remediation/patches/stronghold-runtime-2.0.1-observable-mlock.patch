@@ -334,0 +387,28 @@ mod test {
+    #[test]
+    fn glymize_injected_native_failures_are_observable_and_cleanup() {
+        GLYMIZE_FORCE_ALLOCATION_FAILURE.store(true, Ordering::SeqCst);
+        let allocation_result = std::panic::catch_unwind(|| Boxed::<u8>::new(32, |_| {}));
+        GLYMIZE_FORCE_ALLOCATION_FAILURE.store(false, Ordering::SeqCst);
+        assert!(allocation_result.is_err(), "allocation failure must be visible");
+
+        GLYMIZE_FREE_CALLS.store(0, Ordering::SeqCst);
+        GLYMIZE_FAILED_LOCK_CLEANUPS.store(0, Ordering::SeqCst);
+        GLYMIZE_ZERO_BEFORE_FREE.store(false, Ordering::SeqCst);
+        GLYMIZE_FORCE_MLOCK_FAILURE.store(true, Ordering::SeqCst);
+
+        let lock_result = std::panic::catch_unwind(|| Boxed::<u8>::new(32, |_| {}));
+
+        GLYMIZE_FORCE_MLOCK_FAILURE.store(false, Ordering::SeqCst);
+        assert!(lock_result.is_err(), "mlock failure must be visible");
+        assert_eq!(GLYMIZE_FAILED_LOCK_CLEANUPS.load(Ordering::SeqCst), 1);
+        assert_eq!(GLYMIZE_FREE_CALLS.load(Ordering::SeqCst), 1);
+        assert!(GLYMIZE_ZERO_BEFORE_FREE.load(Ordering::SeqCst));
+
+        GLYMIZE_FREE_CALLS.store(0, Ordering::SeqCst);
+        GLYMIZE_FORCE_MPROTECT_FAILURE.store(true, Ordering::SeqCst);
+        let protection_result = std::panic::catch_unwind(|| Boxed::<u8>::new(32, |_| {}));
+        GLYMIZE_FORCE_MPROTECT_FAILURE.store(false, Ordering::SeqCst);
+        assert!(protection_result.is_err(), "mprotect failure must be visible");
+        assert_eq!(GLYMIZE_FREE_CALLS.load(Ordering::SeqCst), 1);
+    }
