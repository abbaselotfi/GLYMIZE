{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glymize-rc-portal-staging",
  "account_id": "b20d3bdc6e9aa99609a44f4a147f9ac7",
  "main": "src/platform-v3.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Preserve the existing RC variables; secrets are managed remotely.
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "AI_CONFIG_KV", "id": "0b88c7b5544e4b848aaf748ed6a6e75b" }
  ],
  "d1_databases": [
    {
      "binding": "GLYMIZE_DB",
      "database_name": "glymize-runtime-rc",
      "database_id": "3fa1a950-189d-487c-9ffc-8f91a4557117",
      "migrations_dir": "migrations",
      // Owner authorization is limited to 0018. Do not widen automatically.
      "migrations_pattern": "migrations/0018_patient_access_rbac.sql"
    }
  ],
  "r2_buckets": [
    { "binding": "PORTAL_MEDIA", "bucket_name": "glymize-portal-media-rc" }
  ]
}
